<section class="contact" id="contact">
  <div class="wrap">
    <p class="contact-kicker">{{ site.contact.kicker }}</p>
    <h2 class="contact-title">
      <span class="lang-zh">{{ site.contact.titleZh | safe }}</span>
      <span class="lang-en">{{ site.contact.titleEn | safe }}</span>
    </h2>
    <a class="contact-mail" href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
    <div class="contact-grid">
      {% for column in site.contact.columns %}
      <div>
        <h4>{{ column.heading }}</h4>
        {% if column.zh %}<p><span class="lang-zh">{{ column.zh | safe }}</span><span class="lang-en">{{ column.en | safe }}</span></p>{% endif %}
        {% if column.links %}<ul>{% for link in column.links %}<li><a href="{{ link.href }}" target="_blank" rel="noopener">{{ link.label }}</a></li>{% endfor %}</ul>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
